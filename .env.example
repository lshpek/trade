# App
APP_ENV=development
APP_NAME=BOTVEX AI Trader
LOG_LEVEL=INFO

# Telegram Mini App authentication (link a Telegram ID only after password login)
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
DEV_AUTH_ENABLED=false
BOTVEX_IDENTITY_DB_PATH=data/botvex_identity.sqlite3

# Integrations are intentionally not connected in this starter
GEMINI_API_KEY=
GEMINI_MODEL=
BROKER_API_KEY=
BROKER_API_SECRET=
DATABASE_URL=

# Local PAPER simulation only; use a persistent volume for deployed SQLite storage
BOTVEX_DB_PATH=data/botvex_paper.sqlite3
PAPER_INITIAL_CASH=10000
PAPER_FEE_RATE=0.001
